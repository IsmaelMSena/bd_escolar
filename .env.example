# =========================================================================
# CONFIGURACIÓN OPCIONAL DE PERSISTENCIA EN LA NUBE (SUPABASE)
# =========================================================================
# Si estos valores no se definen, la aplicación opera de forma 100% autónoma
# en modo aula local utilizando localStorage.
#
# Para activar persistencia en la nube:
# 1. Copiá este archivo como .env.local
# 2. Completá con las claves públicas obtenidas en tu panel de Supabase:

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica
